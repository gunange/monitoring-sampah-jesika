{
	"folders": [
		{
			"path": "api"
		},
		{
			"path": "vue"
		},
		{
			"path": "ml"
		}
	],
	"launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Bun API",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "bun",
        "runtimeArgs": ["run", "dev"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "name": "Vue Dev",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev"],
        "cwd": "${workspaceFolder}/../vue",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "name": "ML Service",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": ["ml.app.service:app", "--host", "0.0.0.0", "--port", "3102"],
        "envFile": "${workspaceFolder:ml}/.env",
        "env": { "PYTHONPATH": "${workspaceFolder:ml}/.." },
        "python": "${workspaceFolder:ml}/.venv/bin/python",
        "cwd": "${workspaceFolder:ml}/..",
        "console": "integratedTerminal",
        "justMyCode": true
      },
      {
        "name": "ML Capture",
        "type": "python",
        "request": "launch",
        "module": "ml.app.capture",
        "args": ["--sample-interval", "10", "--alert-threshold", "12"],
        "envFile": "${workspaceFolder:ml}/.env",
        "env": {
          "PYTHONPATH": "${workspaceFolder:ml}/.."
        },
        "python": "${workspaceFolder:ml}/.venv/bin/python",
        "cwd": "${workspaceFolder:ml}/..",
        "console": "integratedTerminal",
        "justMyCode": true
      }
    ],
    "compounds": [
      {
        "name": "All Services",
        "configurations": ["Bun API", "Vue Dev"]
      },
      {
        "name": "All Services + ML",
        "configurations": ["Bun API", "Vue Dev", "ML Service"]
      }
    ]
  }
}