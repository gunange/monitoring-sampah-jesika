# Backend API
API_BASE=http://localhost:3101
API_KEY=ubah_token_ini

# --- Kamera & streaming ---
CAMERA_SRC=0
CAMERA_BACKEND=AVFOUNDATION
STREAM_FPS=10
SAMPLE_INTERVAL_S=10

# --- Heuristik deteksi trashPct ---
ALERT_THRESHOLD=12
DETECT_COOLDOWN_S=300
DETECT_SAVE_DIR=ml/data/detections

# --- Person suppression & ROI ---
PERSON_SUPPRESS=1
PERSON_AREA_PCT=5
ROI_X=0
ROI_Y=0
ROI_W=0
ROI_H=0

# --- Logging deteksi (JSON list of objects) ---
DETECTIONS_JSON=ml/logs/detections.json

# --- KNN ---
KNN_ENABLED=true
KNN_MODEL_PATH=ml/models/knn.joblib
KNN_NEIGHBORS=5

# Model paths
MODEL_PATH=models/knn_v1.joblib
SCALER_PATH=models/scaler_v1.joblib