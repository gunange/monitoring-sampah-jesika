generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id         Int      @id @default(autoincrement())
  label      String   @db.VarChar(150)
  role       String   @db.VarChar(150)
  created_at DateTime @default(now())
  User       User[]

  @@map("__roles")
}

model User {
  id             Int      @id @default(autoincrement())
  role_id        Int
  username       String   @unique
  password       String
  remember_token String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  Role               Role                 @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: Cascade)
  PersonalAksesToken PersonalAksesToken[]
  Petugas            Petugas[]

  @@index([role_id], map: "__users_role_id_fkey")
  @@map("__users")
}

model PersonalAksesToken {
  id           Int       @id @default(autoincrement())
  user_id      Int
  name         String
  ip_address   String    @db.VarChar(50)
  user_agent   String?   @db.LongText
  token        String    @db.VarChar(100)
  last_used_at DateTime  @default(now())
  expires_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "__personal_access_tokens_user_id_fkey")
  @@map("__personal_access_tokens")
}

model Storage {
  uid        String   @id @default(cuid())
  name       String
  path       String
  mime_type  String
  size       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Dataset Dataset[] @relation("StorageDataset")

  @@map("__storage")
}

model Petugas {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  nip        String
  nama       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("__petugas")
}

model Dataset {
  id               Int      @id @default(autoincrement())
  storage_uid      String
  label            String   @db.VarChar(150)
  h_mean           Float
  h_std            Float
  s_mean           Float
  s_std            Float
  v_mean           Float
  v_std            Float
  laplacian_var    Float
  edge_ratio       Float
  shape_area_ratio Float
  frame            Json
  roi              Json
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  Storage Storage @relation("StorageDataset", fields: [storage_uid], references: [uid], onDelete: Cascade)

  @@index([storage_uid], map: "__dataset_uid_storage_fkey")
  @@map("__dataset")
}
