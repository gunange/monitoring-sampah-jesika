{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Bun API",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "bun",
        "args": ["run", "dev"],
        "cwd": "${workspaceFolder}/api",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "name": "Vue Dev",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "args": ["run", "dev"],
        "cwd": "${workspaceFolder}/vue",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      }
    ],
    "compounds": [
      {
        "name": "All Services",
        "configurations": ["Bun API", "Vue Dev"]
      }
    ]
  }