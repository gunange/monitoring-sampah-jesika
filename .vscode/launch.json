{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bun API",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "args": ["run", "dev"],
      "cwd": "${workspaceFolder}/api",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Vue Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "args": ["run", "dev"],
      "cwd": "${workspaceFolder}/vue",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "ML Service",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/ml/.venv/bin/python",
      "module": "uvicorn",
      "args": ["ml.app.service:app", "--host", "127.0.0.1", "--port", "3102"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/ml/.env",
      "justMyCode": true
    },
    
  ],
  "compounds": [
    {
      "name": "All Services",
      "configurations": ["Bun API", "Vue Dev", "ML Service"]
    },
    {
      "name": "All Services + ML",
      "configurations": ["Bun API", "Vue Dev", "ML Service"]
    }
  ]
}